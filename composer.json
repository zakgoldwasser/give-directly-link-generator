{
    "name": "work-sample/campaign-link-studio",
    "type": "project",
    "description": "An independent, contract-driven fundraising link work sample.",
    "license": "proprietary",
    "require": {"php": "^8.3", "laravel/framework": "^13.0"},
    "require-dev": {"phpunit/phpunit": "^12.0"},
    "autoload": {"psr-4": {"App\\": "app/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "test": "phpunit"
    },
    "config": {"sort-packages": true, "preferred-install": "dist", "optimize-autoloader": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
